# Fake settings for "npm test". These tests never reach a real database,
# so these values are not secrets. Port 9 on 127.0.0.1 has no server:
# if a test calls the database by mistake, it fails immediately.
SUPABASE_URL=http://127.0.0.1:9
SUPABASE_SECRET_KEY=fake-key-for-tests
RESERVATION_TTL_SECONDS=600
