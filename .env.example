# Copy this file to .env and fill in real values. Never commit .env.

# Supabase project URL. Find it in Supabase: Project Settings -> Data API.
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase secret key (starts with sb_secret_). Find it in Supabase: Project Settings -> API Keys.
# Server-side only. Never put it in a browser, in Swagger, or in git.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# How long a reservation holds stock, in seconds. Default: 600 (10 minutes).
RESERVATION_TTL_SECONDS=600

# Port for local development (npm run dev). Vercel ignores this.
PORT=3000
